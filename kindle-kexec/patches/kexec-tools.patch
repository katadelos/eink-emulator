+#ifdef KINDLE_KEXEC_MODULE
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <errno.h>
+static inline long kindle_kexec_ioctl(unsigned int request, void *arg)
+{
+    int fd = open("/dev/kexec", O_RDONLY);
+    long result;
+    int saved_errno;
+    if (fd < 0) return -1;
+    result = ioctl(fd, request, arg);
+    saved_errno = errno;
+    close(fd);
+    errno = saved_errno;
+    return result;
+}
+#endif
+
 struct kexec_segment;
 
