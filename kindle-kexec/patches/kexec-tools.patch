+        args = { entry, nr_segments, segments, flags };
+    return kindle_kexec_ioctl(LINUX_REBOOT_CMD_KEXEC - 1, &args);
+#else
+    return (long) syscall(__NR_kexec_load, entry, nr_segments, segments, flags);
+#endif
